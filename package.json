{
  "author": {
    "email": "daniel@honestempire.com",
    "name": "Daniel Morris",
    "url": "https://unfun.co"
  },
  "bugs": {
    "url": "https://github.com/unfunco/prettier-plugin-yaml/issues"
  },
  "description": "YAML plugin for Prettier that avoids indentation of sequence values.",
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/unfunco/prettier-plugin-yaml#readme",
  "keywords": [
    "prettier",
    "prettier-plugin",
    "sequence",
    "yaml"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@unfunco/prettier-plugin-yaml",
  "overrides": {
    "minimatch@^10.0.0": "11.0.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unfunco/prettier-plugin-yaml"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node --eval \"fs.rmSync('dist', { force: true, recursive: true })\"",
    "fmt:check": "prettier --check .",
    "fmt:fix": "prettier --write .",
    "lint:check": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.4.1"
}
